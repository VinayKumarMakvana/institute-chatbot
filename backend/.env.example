# ==========================================
# EduBot Configuration - Environment Variables
# ==========================================

# --- SECURITY ---
# Secret key used for signing JWT tokens. 
# Generate a secure key using: openssl rand -hex 32
JWT_SECRET=your_super_secret_jwt_key_here
JWT_ALGORITHM=HS256
JWT_EXPIRATION=60

# --- ADMIN CREDENTIALS ---
# Static credentials for the initial administrator account
ADMIN_EMAIL=admin@edubot.com
# Use a strong password hash (e.g., bcrypt). Do not store plaintext here.
ADMIN_PASSWORD_HASH=$2b$12$YourHashedPasswordStringGoesHere

# --- MONGODB ---
# Connection URI for the MongoDB instance
MONGODB_URI=mongodb://localhost:27017
# Name of the database to use
MONGODB_DB_NAME=edubot

# --- FAISS / VECTOR STORE ---
# Path where FAISS indices will be stored locally
FAISS_INDEX_PATH=./faiss_indexes

# --- GEMINI / LLM ---
# Google Gemini API Key for Embeddings and Chat Generation
GEMINI_API_KEY=your_gemini_api_key_here

# --- NOTIFICATIONS ---
# Default polling interval in seconds (used by frontend client)
NOTIFICATION_POLL_INTERVAL=30
