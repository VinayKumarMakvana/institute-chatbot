# ==========================================
# INSTITUTE AI AGENT - ENVIRONMENT VARIABLES
# ==========================================

# --- APPLICATION SETTINGS ---
# Environment: 'development' or 'production'
APP_ENV=development
# Backend API URL (where the FastAPI server is running)
BACKEND_URL=http://localhost:8000
# Frontend URL (where the UI is hosted, for CORS setup)
FRONTEND_URL=http://localhost:5500

# --- SECURITY & AUTHENTICATION ---
# Secret key used for signing JWT tokens (MUST BE CHANGED IN PRODUCTION)
JWT_SECRET=supersecretkey_change_in_production
JWT_ALGORITHM=HS256
JWT_EXPIRATION=1440

# --- ADMIN ACCOUNT CONFIGURATION ---
# Default admin credentials (created automatically if not exists)
ADMIN_EMAIL=admin@example.com
# Use bcrypt to hash the admin password (default below is '1234')
ADMIN_PASSWORD_HASH=$2b$12$0DBi.NtEflRKEMqujyaVyekgsoDa57/49g2X/HRmKvmPoujclAaXK

# --- AI & EMBEDDINGS (RAG) ---
# Available providers: gemini (or add 'mock' for testing)
AI_PROVIDER=gemini
AI_API_KEY=YOUR_GEMINI_API_KEY_HERE